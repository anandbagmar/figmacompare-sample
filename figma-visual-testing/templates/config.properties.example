FIGMA_TOKEN=
APPLITOOLS_API_KEY=
APPLITOOLS_SERVER_URL=
APP_NAME=Applitools-Images
FIGMA_CACHE_DIR=downloaded_images/figma-cache
# Optional: path to the shared Figma Excel file used by uploadFromFigma and
# compareWithFigma. Leave blank to use the built-in default
# (figma-visual-testing/figma_visual_tests.xlsx). Can also be overridden per-run via
# -PfigmaExcel=<path> or a FIGMA_EXCEL_FILE environment variable - useful if different
# projects, or web vs mobile, should use different files.
FIGMA_EXCEL_FILE=
# Optional: Applitools batch name uploadFromFigma groups all baselines under in one run.
# Leave blank to default to "Upload from Figma". Also overridable via an
# APPLITOOLS_BATCH_NAME environment variable.
APPLITOOLS_BATCH_NAME=
# Optional: match level for compareWithFigma comparisons (any com.applitools.eyes.MatchLevel
# value, e.g. STRICT, EXACT, LAYOUT, CONTENT - case-insensitive). Leave blank to default to
# STRICT. An invalid value hard-fails immediately with the list of valid options.
APPLITOOLS_MATCH_LEVEL=
# Optional: Eyes branch/environment name used by the Android/iOS compareWithFigma paths.
# Leave blank to default to "main" / "prod" respectively.
APPLITOOLS_BRANCH_NAME=
APPLITOOLS_ENVIRONMENT_NAME=
# Optional: path to Appium's Node.js entrypoint, for a project layout where it isn't
# vendored at the default ./node_modules/appium/build/lib/main.js.
APPIUM_JS_PATH=
